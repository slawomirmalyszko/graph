# Local Streamlit connection to AuraDB. Copy this file to .env and replace the values.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
# NEO4J_DATABASE=neo4j

# Amazon Bedrock text-generation adapter. AWS credentials come from the default
# boto3 credential chain and must never be stored in this file.
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=512
BEDROCK_TEMPERATURE=0

# Query generation mode: mock is deterministic and requires no AWS credentials.
# Use bedrock only after configuring short-lived local AWS authentication.
QUERY_MODE=mock
