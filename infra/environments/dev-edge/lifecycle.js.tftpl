function handler(event) {
    var maintenanceMode = ${maintenance_mode};

    if (!maintenanceMode) {
        return event.request;
    }

    return {
        statusCode: 503,
        statusDescription: 'Service Unavailable',
        headers: {
            'cache-control': { value: 'no-store, max-age=0' },
            'content-type': { value: 'text/html; charset=utf-8' },
            'content-security-policy': { value: "default-src 'none'; style-src 'unsafe-inline'" },
            'referrer-policy': { value: 'no-referrer' },
            'retry-after': { value: '300' },
            'x-content-type-options': { value: 'nosniff' },
            'x-frame-options': { value: 'DENY' }
        },
        body: {
            encoding: 'text',
            data: '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Integration Catalogue</title><style>body{margin:0;background:#0e1117;color:#fafafa;font-family:system-ui,sans-serif;display:grid;min-height:100vh;place-items:center}main{max-width:42rem;padding:3rem;text-align:center}h1{font-size:2.4rem;margin-bottom:1rem}p{color:#b7bec9;font-size:1.1rem;line-height:1.6}</style></head><body><main><h1>Integration Catalogue</h1><p>DEV is currently in maintenance mode. Start the environment when you want to use the catalogue.</p></main></body></html>'
        }
    };
}

